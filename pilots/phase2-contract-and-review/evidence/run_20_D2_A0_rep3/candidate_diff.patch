 """Shipping calculation module."""
 from __future__ import annotations
 
+from dataclasses import dataclass
 from decimal import Decimal, ROUND_HALF_UP
 
 DEFAULT_RATE_PER_KG: Decimal = Decimal("5.00")
 
+__all__ = [
+    "DEFAULT_RATE_PER_KG",
+    "ShippingQuote",
+    "calculate_shipping",
+    "get_supported_destinations",
+]
+
+
+@dataclass
+class ShippingQuote:
+    """Dataclass holding shipping quote calculation details."""
+    base_fee: Decimal
+    express_fee: Decimal
+    total_fee: Decimal
+
 
 def get_supported_destinations() -> list[str]:
     """Public API: returns destinations recognized by shipping carriers."""
     return ["DOMESTIC", "INTERNATIONAL", "EXPRESS_ZONE"]
 
 
-def calculate_shipping(weight_kg: Decimal, destination: str) -> Decimal:
-    """Calculate shipping fee. Legacy contract returning raw Decimal."""
+def calculate_shipping(
+    weight_kg: Decimal,
+    destination: str,
+    express: bool = False,
+) -> ShippingQuote:
+    """Calculate shipping fee and return a ShippingQuote.
+
+    Rules:
+    - weight_kg must be Decimal and strictly > 0 (no bool, float, str, or <= 0).
+    - destination must be in get_supported_destinations().
+    - express must be bool (default False). True -> express_fee=12.50, False -> 0.00.
+    - base_fee = (weight_kg * rate).quantize(Decimal("0.01"), rounding=ROUND_HALF_UP).
+    - total_fee = base_fee + express_fee.
+    """
+    if isinstance(weight_kg, bool) or not isinstance(weight_kg, Decimal):
+        raise ValueError("Invalid weight")
+    if weight_kg.is_nan() or not weight_kg.is_finite() or weight_kg <= Decimal("0"):
+        raise ValueError("Invalid weight")
+
+    if destination not in get_supported_destinations():
+        raise ValueError("Unsupported destination")
+
+    if not isinstance(express, bool):
+        raise TypeError("Invalid express: must be a bool")
+
     if destination == "DOMESTIC":
         rate = Decimal("5.00")
     elif destination == "INTERNATIONAL":
@@ -21,4 +60,13 @@ def calculate_shipping(weight_kg: Decimal, destination: str) -> Decimal:
         rate = Decimal("25.00")
     else:
         raise ValueError("Unsupported destination")
-    return (weight_kg * rate).quantize(Decimal("0.01"), rounding=ROUND_HALF_UP)
+
+    base_fee = (weight_kg * rate).quantize(Decimal("0.01"), rounding=ROUND_HALF_UP)
+    express_fee = Decimal("12.50") if express else Decimal("0.00")
+    total_fee = base_fee + express_fee
+
+    return ShippingQuote(
+        base_fee=base_fee,
+        express_fee=express_fee,
+        total_fee=total_fee,
+    )
