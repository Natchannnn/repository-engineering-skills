+class TestWeightValidation(unittest.TestCase):
+    def test_zero_weight(self):
+        with self.assertRaises(ValueError) as ctx:
+            calculate_shipping(Decimal("0"), "DOMESTIC")
+        self.assertEqual(str(ctx.exception), "Invalid weight")
+
+        with self.assertRaises(ValueError) as ctx:
+            calculate_shipping(Decimal("0.00"), "DOMESTIC")
+        self.assertEqual(str(ctx.exception), "Invalid weight")
+
+    def test_negative_weight(self):
+        with self.assertRaises(ValueError) as ctx:
+            calculate_shipping(Decimal("-1.0"), "DOMESTIC")
+        self.assertEqual(str(ctx.exception), "Invalid weight")
+
+        with self.assertRaises(ValueError) as ctx:
+            calculate_shipping(Decimal("-0.01"), "DOMESTIC")
+        self.assertEqual(str(ctx.exception), "Invalid weight")
+
+    def test_non_decimal_weight(self):
+        invalid_weights = [
+            1,
+            2.5,
+            "1.0",
+            True,
+            False,
+            None,
+            [Decimal("1.0")],
+            {"weight": Decimal("1.0")},
+        ]
+        for val in invalid_weights:
+            with self.subTest(val=val):
+                with self.assertRaises(ValueError) as ctx:
+                    calculate_shipping(val, "DOMESTIC")
+                self.assertEqual(str(ctx.exception), "Invalid weight")
+
+    def test_special_decimal_values(self):
+        for val in [Decimal("NaN"), Decimal("Infinity"), Decimal("-Infinity")]:
+            with self.subTest(val=val):
+                with self.assertRaises(ValueError) as ctx:
+                    calculate_shipping(val, "DOMESTIC")
+                self.assertEqual(str(ctx.exception), "Invalid weight")
