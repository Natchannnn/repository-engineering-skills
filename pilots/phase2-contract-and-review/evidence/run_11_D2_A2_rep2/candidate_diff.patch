+        self.assertEqual(q_int.total_fee, Decimal("15.00"))
+
+        # EXPRESS_ZONE (rate 25.00)
+        q_ez = calculate_shipping(Decimal("1.0"), "EXPRESS_ZONE")
+        self.assertEqual(q_ez.base_fee, Decimal("25.00"))
