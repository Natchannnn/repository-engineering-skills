@@ -1,24 +1,63 @@
 """Shipping calculation module."""
 from __future__ import annotations
 
+from dataclasses import dataclass
 from decimal import Decimal, ROUND_HALF_UP
 
 DEFAULT_RATE_PER_KG: Decimal = Decimal("5.00")
 
+DESTINATION_RATES: dict[str, Decimal] = {
+    "DOMESTIC": Decimal("5.00"),
+    "INTERNATIONAL": Decimal("15.00"),
+    "EXPRESS_ZONE": Decimal("25.00"),
+}
+
+EXPRESS_FEE: Decimal = Decimal("12.50")
+STANDARD_EXPRESS_FEE: Decimal = Decimal("0.00")
+
+
+class InvalidExpressError(TypeError, ValueError):
+    """Raised when express flag is not a boolean."""
+
+
+@dataclass
+class ShippingQuote:
+    """Represents calculated shipping fees."""
+    base_fee: Decimal
+    express_fee: Decimal
+    total_fee: Decimal
+
 
 def get_supported_destinations() -> list[str]:
     """Public API: returns destinations recognized by shipping carriers."""
     return ["DOMESTIC", "INTERNATIONAL", "EXPRESS_ZONE"]
 
 
-def calculate_shipping(weight_kg: Decimal, destination: str) -> Decimal:
-    """Calculate shipping fee. Legacy contract returning raw Decimal."""
-    if destination == "DOMESTIC":
-        rate = Decimal("5.00")
-    elif destination == "INTERNATIONAL":
-        rate = Decimal("15.00")
-    elif destination == "EXPRESS_ZONE":
-        rate = Decimal("25.00")
-    else:
+def calculate_shipping(
+    weight_kg: Decimal,
+    destination: str,
+    express: bool = False,
+) -> ShippingQuote:
+    """Calculate shipping fee and return a ShippingQuote."""
+    if isinstance(weight_kg, bool) or not isinstance(weight_kg, Decimal):
+        raise ValueError("Invalid weight")
+    if not weight_kg.is_finite() or weight_kg <= Decimal("0"):
+        raise ValueError("Invalid weight")
+
+    supported_destinations = get_supported_destinations()
+    if destination not in supported_destinations:
         raise ValueError("Unsupported destination")
-    return (weight_kg * rate).quantize(Decimal("0.01"), rounding=ROUND_HALF_UP)
+
+    if not isinstance(express, bool):
+        raise InvalidExpressError("express must be a bool")
+
+    rate = DESTINATION_RATES.get(destination, DEFAULT_RATE_PER_KG)
+    base_fee = (weight_kg * rate).quantize(Decimal("0.01"), rounding=ROUND_HALF_UP)
+    express_fee = EXPRESS_FEE if express else STANDARD_EXPRESS_FEE
+    total_fee = base_fee + express_fee
+
+    return ShippingQuote(
+        base_fee=base_fee,
+        express_fee=express_fee,
+        total_fee=total_fee,
+    )
