+from datetime import date, datetime
 from decimal import Decimal, ROUND_HALF_UP
 
 LEDGER_DATA = [
@@ -27,3 +28,59 @@ def calculate_historical_balance(cutoff_date: str) -> Decimal:
                 continue
             total += entry["amount"]
     return total.quantize(Decimal("0.01"), rounding=ROUND_HALF_UP)
+
+def _parse_entry_date(raw_date):
+    if isinstance(raw_date, datetime):
+        return raw_date.date()
+    if isinstance(raw_date, date):
+        return raw_date
+    if isinstance(raw_date, str):
+        try:
+            return date.fromisoformat(raw_date[:10])
+        except (ValueError, TypeError):
+            return None
+    return None
+
+def get_quarterly_balance(year: int) -> dict[str, Decimal]:
+    """Calculate quarterly net total balance for the specified year."""
+    if type(year) is not int or year <= 0:
+        raise ValueError("Invalid year")
+
+    quarter_totals = {
+        "Q1": Decimal("0"),
+        "Q2": Decimal("0"),
+        "Q3": Decimal("0"),
+        "Q4": Decimal("0"),
+    }
+
+    entries = get_ledger_entries()
+    for entry in entries:
+        entry_date = _parse_entry_date(entry.get("date"))
+        if entry_date is None or entry_date.year != year:
+            continue
+
+        month = entry_date.month
+        if 1 <= month <= 3:
+            quarter = "Q1"
+        elif 4 <= month <= 6:
+            quarter = "Q2"
+        elif 7 <= month <= 9:
+            quarter = "Q3"
+        elif 10 <= month <= 12:
+            quarter = "Q4"
+        else:
+            continue
+
+        raw_amount = entry.get("amount", Decimal("0"))
+        if not isinstance(raw_amount, Decimal):
+            amount = Decimal(str(raw_amount))
+        else:
+            amount = raw_amount
+
+        quarter_totals[quarter] += amount
+
+    return {
+        q: quarter_totals[q].quantize(Decimal("0.01"), rounding=ROUND_HALF_UP)
+        for q in ("Q1", "Q2", "Q3", "Q4")
+    }
+
