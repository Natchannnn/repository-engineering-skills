{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "repo-native-refactor-harness/suite-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "name", "variants", "cases"],
  "properties": {
    "$schema": {"const": "repo-native-refactor-harness/suite-v1"},
    "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"},
    "repetitions": {"type": "integer", "minimum": 1, "maximum": 20, "default": 3},
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "skill"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"},
          "skill": {"type": ["string", "null"]}
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "repository", "task", "verification"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"},
          "repository": {"type": "string", "minLength": 1},
          "revision": {"type": "string", "minLength": 1, "default": "HEAD"},
          "history": {"enum": ["none", "ancestors"], "default": "none"},
          "task": {"type": "string", "minLength": 1},
          "protected_paths": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "allowed_paths": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "verification": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "argv"],
              "properties": {
                "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"},
                "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
                "cwd": {"type": "string"},
                "env": {"type": "object", "additionalProperties": {"type": "string"}},
                "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
                "expose_to_runner": {"type": "boolean", "default": true}
              }
            }
          }
        }
      }
    }
  }
}
