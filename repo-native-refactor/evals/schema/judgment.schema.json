{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "repo-native-refactor-harness/judgment-v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "artifact_id", "verdict", "bar_evidence", "hard_failures", "dimensions", "confidence", "notes"],
  "properties": {
    "$schema": {"const": "repo-native-refactor-harness/judgment-v2"},
    "artifact_id": {"type": "string", "pattern": "^[a-f0-9]{16}$"},
    "verdict": {"enum": ["pass", "fail", "invalid"]},
    "bar_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "claim", "verdict", "evidence"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "claim": {"type": "string", "minLength": 1},
          "verdict": {"enum": ["pass", "fail"]},
          "evidence": {"type": "string", "minLength": 1}
        }
      }
    },
    "hard_failures": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "score", "evidence"],
        "properties": {
          "id": {"type": "string"},
          "score": {"type": "integer", "minimum": 0, "maximum": 4},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "confidence": {"enum": ["high", "medium", "low"]},
    "notes": {"type": "string"}
  }
}
