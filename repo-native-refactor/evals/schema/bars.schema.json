{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "repo-native-refactor-harness/bars-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "first_principles", "dimensions", "cases"],
  "properties": {
    "$schema": {"const": "repo-native-refactor-harness/bars-v1"},
    "first_principles": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "bar"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"},
          "weight": {"type": "number", "exclusiveMinimum": 0, "default": 1},
          "bar": {"type": "string", "minLength": 1}
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "outcome"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"},
          "outcome": {"type": "string", "minLength": 1},
          "smells": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "certification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required_repetitions": {"type": "integer", "minimum": 1, "maximum": 20},
        "min_pass_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "min_rating": {"type": "number", "minimum": 0, "maximum": 10}
      }
    }
  }
}
