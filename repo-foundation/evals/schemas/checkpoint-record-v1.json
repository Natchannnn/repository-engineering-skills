{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "repo-foundation-harness/checkpoint-record-v1",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "journey_id",
    "variant_id",
    "repetition_id",
    "checkpoint_id",
    "order",
    "parent_checkpoint_id",
    "parent_snapshot_hash",
    "candidate_snapshot_hash",
    "lifecycle_status",
    "execution_status",
    "measurement_validity",
    "output_quality",
    "synthetic"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "repo-foundation-harness/checkpoint-record-v1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "journey_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"
    },
    "variant_id": {
      "type": "string",
      "enum": ["A", "B", "C", "D"]
    },
    "repetition_id": {
      "type": "string",
      "pattern": "^rep[0-9]{2}$"
    },
    "checkpoint_id": {
      "type": "string",
      "enum": [
        "CP1_BOOTSTRAP",
        "CP2_SLICE",
        "CP3_EVOLUTION",
        "CP4_CONTINUITY"
      ]
    },
    "order": {
      "type": "integer",
      "enum": [1, 2, 3, 4]
    },
    "parent_checkpoint_id": {
      "type": ["string", "null"],
      "enum": [null, "CP1_BOOTSTRAP", "CP2_SLICE", "CP3_EVOLUTION"]
    },
    "parent_snapshot_hash": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{64}$"
    },
    "candidate_snapshot_hash": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{64}$"
    },
    "lifecycle_status": {
      "type": "string",
      "enum": [
        "PREPARED",
        "EXECUTING",
        "COLLECTED",
        "VERIFIED",
        "JUDGED",
        "SCORED",
        "BLOCKED_BY_PREDECESSOR"
      ]
    },
    "execution_status": {
      "type": ["string", "null"],
      "enum": [
        null,
        "COMPLETED",
        "TIMEOUT",
        "BUDGET_EXHAUSTED",
        "INFRA_ERROR",
        "BLOCKED_BY_PREDECESSOR"
      ]
    },
    "measurement_validity": {
      "type": ["string", "null"],
      "enum": [
        null,
        "VALID",
        "EVALUATION_INVALID",
        "PENDING_VERIFICATION",
        "UNRESOLVED"
      ]
    },
    "output_quality": {
      "type": ["string", "null"],
      "enum": [
        null,
        "PASS",
        "FAIL",
        "HARD_FAILURE",
        "UNRESOLVED"
      ]
    },
    "synthetic": {
      "type": "boolean"
    },
    "per_checkpoint_diff_sha256": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{64}$"
    },
    "cumulative_diff_sha256": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{64}$"
    },
    "check_results": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "exit_code",
          "timed_out",
          "duration_seconds"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": ["environment", "acceptance", "regression"]
          },
          "status": {
            "type": ["string", "null"],
            "enum": [
              null,
              "PASSED",
              "FAILED",
              "NOT_YET_IMPLEMENTED",
              "ACCEPTANCE_FAILED",
              "ENVIRONMENT_CHECK_FAILED",
              "INFRA_ERROR",
              "TIMEOUT"
            ]
          },
          "exit_code": {
            "type": ["integer", "null"]
          },
          "timed_out": {
            "type": "boolean"
          },
          "duration_seconds": {
            "type": "number",
            "minimum": 0
          },
          "message": {
            "type": ["string", "null"]
          },
          "stdout": {
            "type": ["string", "null"]
          },
          "stderr": {
            "type": ["string", "null"]
          }
        }
      }
    },
    "usage": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "tokens_input": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "tokens_output": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "wall_time_seconds": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "observed_artifacts": {
          "type": ["integer", "null"],
          "minimum": 0
        }
      }
    }
  }
}
