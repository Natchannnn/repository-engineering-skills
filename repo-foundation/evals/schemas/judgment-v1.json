{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JudgmentV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "verdict",
    "bar_evidence",
    "hard_failures",
    "dimensions",
    "confidence",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "repo-foundation-harness/judgment-v1"
    },
    "artifact_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "invalid",
        "unresolved"
      ]
    },
    "bar_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "claim",
          "verdict",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "verdict": {
            "type": "string",
            "enum": ["pass", "fail"]
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "hard_failures": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "dimensions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "score"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "score": {
            "type": ["integer", "null"],
            "minimum": 0,
            "maximum": 4
          },
          "reason": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "invalid_reasons": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "confidence": {
      "type": "string",
      "enum": ["high", "medium", "low"]
    },
    "notes": {
      "type": "string"
    }
  }
}
