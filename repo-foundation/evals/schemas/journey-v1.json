{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "repo-foundation-harness/journey-v1",
  "type": "object",
  "required": [
    "schema_version",
    "journey_id",
    "name",
    "repetitions",
    "variants",
    "checkpoints",
    "snapshot_policy"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "repo-foundation-harness/journey-v1"
    },
    "journey_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "repetitions": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "skills"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "enum": ["A", "B", "C", "D"]
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "path"],
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "checkpoints": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "name", "order", "task_ref", "checks"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "CP1_BOOTSTRAP",
              "CP2_SLICE",
              "CP3_EVOLUTION",
              "CP4_CONTINUITY"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "order": {
            "type": "integer",
            "enum": [1, 2, 3, 4]
          },
          "task_ref": {
            "type": "string",
            "minLength": 1
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "type", "validity_scope", "command"],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"
                },
                "type": {
                  "type": "string",
                  "enum": ["environment", "acceptance", "regression"]
                },
                "validity_scope": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "enum": [
                      "CP1_BOOTSTRAP",
                      "CP2_SLICE",
                      "CP3_EVOLUTION",
                      "CP4_CONTINUITY"
                    ]
                  }
                },
                "command": {
                  "type": "object",
                  "required": ["argv", "timeout_seconds"],
                  "additionalProperties": false,
                  "properties": {
                    "argv": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "timeout_seconds": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 86400
                    },
                    "cwd": {
                      "type": "string"
                    },
                    "env": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "string"
                      }
                    }
                  }
                },
                "replaces_check_id": {
                  "type": ["string", "null"],
                  "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"
                },
                "entrypoint": {
                  "type": ["string", "null"],
                  "minLength": 1
                },
                "tool": {
                  "type": ["string", "null"],
                  "minLength": 1
                },
                "verifier_entrypoint": {
                  "type": ["string", "null"],
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "snapshot_policy": {
      "type": "object",
      "required": ["include", "exclude"],
      "additionalProperties": false,
      "properties": {
        "include": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
