{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JudgeIndexV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "rubric_sha256",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "repo-foundation-harness/judge-index-v1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "rubric_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "packet_id",
          "journey_id",
          "variant_id",
          "repetition_id",
          "checkpoint_id",
          "order",
          "path",
          "status"
        ],
        "properties": {
          "artifact_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{16}$"
          },
          "packet_id": {
            "type": "string",
            "minLength": 1
          },
          "journey_id": {
            "type": "string",
            "minLength": 1
          },
          "variant_id": {
            "type": "string",
            "minLength": 1
          },
          "repetition_id": {
            "type": "integer",
            "minimum": 1
          },
          "checkpoint_id": {
            "type": "string",
            "enum": [
              "CP1_BOOTSTRAP",
              "CP2_SLICE",
              "CP3_EVOLUTION",
              "CP4_CONTINUITY"
            ]
          },
          "order": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "packet_sha256": {
            "type": ["string", "null"],
            "pattern": "^[0-9a-f]{64}$"
          },
          "status": {
            "type": "string",
            "enum": [
              "READY",
              "BLOCKED",
              "MISSING",
              "INVALID",
              "INCOMPLETE"
            ]
          },
          "status_reason": {
            "type": "string"
          }
        }
      }
    }
  }
}
