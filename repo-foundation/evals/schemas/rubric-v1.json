{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RubricSpecificationV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "rubric_id",
    "dimensions",
    "required_bars",
    "hard_failure_definitions"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "repo-foundation-harness/rubric-v1"
    },
    "rubric_id": {
      "type": "string",
      "minLength": 1
    },
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "description",
          "applicable_checkpoints",
          "anchors"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "applicable_checkpoints": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": [
                "CP1_BOOTSTRAP",
                "CP2_SLICE",
                "CP3_EVOLUTION",
                "CP4_CONTINUITY"
              ]
            }
          },
          "anchors": {
            "type": "object",
            "additionalProperties": false,
            "required": ["0", "1", "2", "3", "4"],
            "properties": {
              "0": { "type": "string", "minLength": 1 },
              "1": { "type": "string", "minLength": 1 },
              "2": { "type": "string", "minLength": 1 },
              "3": { "type": "string", "minLength": 1 },
              "4": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "required_bars": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "description",
          "applicable_checkpoints"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "applicable_checkpoints": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": [
                "CP1_BOOTSTRAP",
                "CP2_SLICE",
                "CP3_EVOLUTION",
                "CP4_CONTINUITY"
              ]
            }
          }
        }
      }
    },
    "hard_failure_definitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
